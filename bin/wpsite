#!/usr/bin/env bash
#
# wpsite — snapshot production WordPress sites over SSH and rebuild
#          near-perfect local replicas under Docker.
#          Runs on macOS (gateway) and Debian 13 (dev box) — see CLAUDE.md.
#
set -euo pipefail

# Resolve this script's real path, following symlinks (it's meant to be symlinked
# onto PATH, e.g. /usr/local/bin/wpsite), so we can find lib/ relative to the repo.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"   # relative link → absolutize
done
WPSITE_ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
unset _src _dir
export WPSITE_ROOT

# shellcheck source=lib/common.sh
source "$WPSITE_ROOT/lib/common.sh"
# shellcheck source=lib/cloud.sh
source "$WPSITE_ROOT/lib/cloud.sh"   # shared cloud helpers (not a cmd_*.sh, so explicit)
for _f in "$WPSITE_ROOT"/lib/cmd_*.sh; do
  # shellcheck source=/dev/null
  source "$_f"
done
unset _f

VERSION="0.1.0"

usage() {
  cat >&2 <<EOF
wpsite $VERSION — WordPress backup & local replica tool

Usage: wpsite <command> [args]

Commands:
  setup               Onboard this machine: write base_dir to the local config and
                      check that both registries (mandos access + wpsite's own) are
                      reachable. SSH keys are mandos's job: mandos client setup-key
  backup  <client>    Snapshot a remote site (real media by default). A successful
                      backup of a client mandos knows registers it in wpsite.
          --all       …back up every configured client, in sequence
          --light     …use blank placeholder media instead of real files (smaller)
          --persist   …mark the new backup permanent (exempt from rolling prune)
  backup sync [<client>]   Reconcile local backups with the cloud (cloud = truth;
          --all --dry-run   no arg / --all syncs every client)
  backup persist <client> <id> [--off]   Promote/demote an existing backup to permanent
  build   <client>    (Re)build & run a backup as a local replica (newest by default)
          --backup <id>   …use a specific backup (see: wpsite list <client>)
  hold    <client> [<slug>]     Never auto-update this plugin/theme for <client> (upgrade
                      AND apply skip it). No slug → list. --reason "…"  --remove
  manual  <client> [<item>]     Items WP-CLI can't update (e.g. greyd_suite): upgrade/
                      apply remind you to update them in wp-admin. --reason --remove
  show    <client> [<key>]      Everything wpsite knows about a client (access from
                      mandos + wpsite's own settings); with <key>: just that value
  forget  <client>    Drop a client from wpsite (entry + replica); --purge also deletes
                      its local backups. mandos access and cloud backups are untouched.
  migrate-registry    One-off: move WordPress settings out of mandos into wpsite's own
          --apply         registry (dry run without --apply)
  new     [name]      Create a fresh blank dev site (no name → wizard)
          --wp <ver> --php <ver> --host <h>   …pin versions / host (default latest/8.2)
  clone   <name> <devname>   Create a dev site from an ON-DISK backup (newest by
                      default; never takes a fresh one — run 'backup' first)
          --backup <id>      …use a specific backup
          --deactivate <s>   …extra plugin slugs to deactivate (no registry needed)
          --host <h>         …override the local hostname
  push    <client> [<devname>]   GATEWAY: ship the newest local backup to the dev box
                      over rsync and build it there as a dev site (default <client>-dev)
          --backup <id>   …ship a specific backup instead of the newest
          --fresh         …take a new backup from production first
          --light         …with --fresh: placeholder media (much smaller packet)
          --replace       …destroy an existing dev site there first
          --no-clone --dry-run --devbox <host>
  inject  <devsite>   Live-mount a local plugin into a dev site (default: ~/git/aule)
          --from <path> --slug <name>   …mount any plugin checkout under any slug
          --activate [--network]        …activate after mount (--network = multisite-wide)
  start   <site>      Start a stopped replica or dev site (keeps data)
  stop    <site>      Stop a running replica or dev site (keeps data, restartable)
          --all       …stop all running replicas + dev sites
  upgrade <client>    Update core/plugins/themes on the replica + write a report (with visual review)
          --noreview      …skip taking screenshots & opening comparison page
  review  <client>    Re-open the latest upgrade comparison page in the browser
  apply   <client>    Run the rehearsed upgrade ON PRODUCTION: preflight → typed
                      confirmation → fresh backup → maintenance → updates → final check
                      (live pages + test mail) on EVERY exit. Irreversible — rehearse first.
          --check         …run only the preflight (read-only; e.g. before a round)
  maintenance <client> [off|status]   The maintenance lock apply sets on PRODUCTION:
                      status (default) = lock files + what visitors see; off = lift it
  report  <client> [<id>]   Regenerate a maintenance report's PDF from its .txt
                      (edit the .txt first; newest apply by default)
          --upgrade <id> --list --no-open
  redirect <sub> <client>   Manage .htaccess redirects on production (replaces the
                      Redirection plugin): list | add | import | migrate | remove
  destroy <site>      Remove a replica or dev site (containers + DB volume + files)
  prune   <client>    Delete old backups from local + cloud (default: keep newest 5,
          --all           the fixed policy; skips -permanent). Flags: --keep N,
          <id>            --older-than Nd, --dry-run, --yes. Give a <backup-id> to
                          delete just that one (even if permanent).
  prefetch            Warm caches for OFFLINE use: pull core Docker images
                      (WordPress/MariaDB/proxy/mail) + cache the wp-cli phar
  proxy   <action>    Shared reverse proxy + wildcard DNS for running all replicas
                      at once: start | stop | status | install-dns
  mail    <action>    Shared Mailpit that traps all replica email: start | stop | status
  db      <site>      Open a shared Adminer DB browser, logged into <site>'s database
                      (any built client or dev site); no <site> reopens the last one.
                      Manage the container with start | stop | status
  list    [site]      List clients + backups + dev sites (or one site's detail)
          --names         …just client names, one per line (machine-readable)
          --dev-names     …just dev-site names, one per line (machine-readable)
          --backups <c>   …complete backup ids for a client, newest first (machine-readable)
  status              Show running replicas + dev sites and their URLs
  doctor              Verify dependencies and environment
  test    <client>    Verify remote host connection, directories, and CLI/DB readiness.
                      A passing test of a client mandos knows registers it in wpsite
                      (the usual step after: mandos client add <client>)

Global flags:
  -v, --verbose       Verbose logging
  -h, --help          Show this help

Config: $WPSITE_CONFIG
EOF
}

main() {
  # Global flags before the subcommand
  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--verbose) WPSITE_VERBOSE=1; shift ;;
      -h|--help|help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "Unknown global flag: $1" ;;
      *) break ;;
    esac
  done

  [ $# -ge 1 ] || { usage; exit 1; }

  local cmd="$1"; shift

  # Role guard: on a machine configured as role=dev, refuse the gateway commands rather
  # than letting them fail obscurely deeper in. A guardrail against running a production
  # command on the wrong machine at 11pm — NOT a security control: the real boundary is
  # that a dev box holds no production credential at all. See DEVBOX-PLAN.md §5.10.
  case "$cmd" in
    apply|redirect|backup|push|test|prune|forget|hold|manual|migrate-registry|maintenance)
      if [ "$(config_role 2>/dev/null || true)" = "dev" ]; then
        die "'$cmd' is a gateway command, and this machine is configured as role=dev.
  Run it on the gateway — the machine holding the production SSH keys and Drive.
  (Set by 'role: dev' in $WPSITE_CONFIG, or WPSITE_ROLE.)"
      fi ;;
  esac

  case "$cmd" in
    setup)   cmd_setup "$@" ;;
    backup)  cmd_backup "$@" ;;
    build)   cmd_build "$@" ;;
    hold)    cmd_hold "$@" ;;
    manual)  cmd_manual "$@" ;;
    show)    cmd_show "$@" ;;
    forget)  cmd_forget "$@" ;;
    migrate-registry) cmd_migrate_registry "$@" ;;
    new)     cmd_new "$@" ;;
    clone)   cmd_clone "$@" ;;
    push)    cmd_push "$@" ;;
    inject)  cmd_inject "$@" ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    review)  cmd_review "$@" ;;
    apply)   cmd_apply "$@" ;;
    report)  cmd_report "$@" ;;
    maintenance) cmd_maintenance "$@" ;;
    redirect) cmd_redirect "$@" ;;
    destroy) cmd_destroy "$@" ;;
    prune)   cmd_prune "$@" ;;
    prefetch) cmd_prefetch "$@" ;;
    proxy)   cmd_proxy "$@" ;;
    mail)    cmd_mail "$@" ;;
    db)      cmd_db "$@" ;;
    list)    cmd_list "$@" ;;
    status)  cmd_status "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    test)    cmd_test "$@" ;;
    # Renamed verbs — hint instead of a bare "unknown command".
    client) die "'wpsite client' is gone — the registries are split.
  Access (ssh, wp_root, keys):  mandos client add|set|remove|setup-key
  wpsite's own data:            wpsite show|hold|manual <client>, wpsite forget <client>" ;;
    up)   die "'up' was renamed. Use 'wpsite build $*' (rebuild) or 'wpsite start $*' (resume)." ;;
    down) die "'down' was renamed. Use 'wpsite stop $*' (pause) or 'wpsite destroy $*' (remove)." ;;
    *) log_error "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"

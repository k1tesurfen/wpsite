# wpsite's OWN client registry — WordPress/maintenance settings per client, keyed by
# client ID. Lives on the shared Google Drive next to mandos's access registry:
#
#   …/01_Global/mandos/mandos.team.yml    ← mandos: WHO + ACCESS (ssh, wp_root, Drive folder)
#   …/01_Global/wpsite/wpsite.team.yml    ← wpsite: this file
#
# wpsite derives this path from mandos's file, so a machine set up for mandos needs no
# extra configuration (override: `team_config:` in ~/.config/wpsite/wpsite.yml, or
# WPSITE_TEAM_CONFIG). The two registries are NOT linked — they share only the client ID.
# A client mandos knows joins this file with its first `wpsite backup <client>`;
# `wpsite forget <client>` drops it here and never touches mandos.
#
# NEVER put access data (ssh, wp_root, cloud_folder) here — that's mandos's.
# Edited by wpsite with `yq -i` (comments survive); hand edits are fine.
# CAUTION: Google Drive has no file locking — coordinate simultaneous edits.

settings:
  test_mail_to: admin@example.com   # `apply` sends its post-run test mail here (never the
                                    # customer's admin_email)

clients:
  acme:
    registered: "2026-09-23"        # written by the first `wpsite backup acme`
    hold_plugins:                   # never auto-updated by upgrade/apply (plugin OR theme
                                    # slugs) — `wpsite hold acme <slug> --reason "…"`
      advanced-custom-fields-pro: "Pro, Lizenz beim Kunden (2026-09-23)"
    manual_updates:                 # reminders: WP-CLI can't see these updates, update by
                                    # hand in wp-admin — `wpsite manual acme <slug>`
      greyd_suite: "Updates nur in wp-admin sichtbar (2026-09-23)"
    # Optional overrides:
    # remote_tmp: ~/.wpsite_tmp     # remote backup staging dir (default /tmp). Set it (abs
    #                               # or ~/-relative, ABOVE the docroot) when the host's /tmp
    #                               # is small/quota-capped — e.g. Strato.
    # local_host: acme.test         # replica hostname (default: derived from the live domain)
    # login_path: /geheim-login     # custom wp-admin path (WPS Hide Login, …) for the GUI
    # deactivate_plugins:           # extra plugins to disable on the REPLICA
    #   - some-prod-only-plugin     # (caching/optimization/SMTP are disabled by default)
    # review_pages:                 # extra pages to screenshot during `upgrade`
    #   - /kontakt
    # review_dismiss:               # extra CSS selectors to hide before each screenshot
    #   - "#my-cookie-banner"
    # cloud_dir: /abs/…/100_Backup  # machine-specific absolute backup dir (discouraged —
    #                               # the default <cloud_base>/<project folder>/100_Backup
    #                               # resolves for every colleague)

  baker: {}                         # registered, no special settings
